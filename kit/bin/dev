#!/usr/bin/env bash
# simple-ai — lanceur session DEV.
# Isole la session dans un worktree git dédié (HEAD/index/fichiers séparés ;
# git refuse le même checkout dans deux worktrees → garde-fou natif anti-collision),
# affiche la bannière de rôle, signale une éventuelle session DEV déjà active.
#
#   Usage : simple-ai/bin/dev [branche]   (défaut : "dev")
set -euo pipefail

ROLE="DEV"; role="dev"
ROOT="$(git rev-parse --show-toplevel)"
REPO="$(basename "$ROOT")"
WT="$ROOT/../$REPO-$role"
BRANCH="${1:-$role}"
LOCK="$ROOT/simple-ai/.session-$role.lock"

# Garde-fou léger : prévenir si une session DEV vivante existe déjà.
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  echo "⚠️  Une session $ROLE semble déjà active (pid $(cat "$LOCK")). Deux DEV sur le même repo = risque de collision."
fi

# Worktree par session.
if ! git -C "$ROOT" worktree list --porcelain | grep -q "worktree $(cd "$WT" 2>/dev/null && pwd || echo /dev/null)"; then
  if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$ROOT" worktree add "$WT" "$BRANCH"
  else
    git -C "$ROOT" worktree add "$WT" -b "$BRANCH"
  fi
fi

echo $$ > "$LOCK"
cat <<BANNER

  ╔══════════════════════════════════════════╗
  ║   Casquette DEV — simple-ai               ║
  ╚══════════════════════════════════════════╝
  Worktree : $WT  (branche : $BRANCH)
  À lire    : simple-ai/DEV.md  +  simple-ai/CONVENTION.md
  Backlog   : simple-ai/backlog.md  → dépile par priorité, challenge, prouve.

BANNER

cd "$WT"
exec "${SHELL:-bash}"
